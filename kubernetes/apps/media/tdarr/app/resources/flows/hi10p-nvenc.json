{
  "_comment": "Export of the live Tdarr flow (FlowsJSONDB hi10pNvencFlow). Source of truth is Tdarr's DB; re-import via the UI (Flows > Import) or POST /api/v2/cruddb mode=update after replacing the placeholders. Kept here for review and disaster recovery.",
  "_id": "hi10pNvencFlow",
  "name": "Hi10P -> HEVC Main10 (NVENC)",
  "description": "Re-encode only H.264 10-bit video with hevc_nvenc Main10; every audio/subtitle/attachment stream copied; MKV kept. Output is a new file (rename + move), never an in-place edit, so a seeding torrent's hardlinked copy stays intact (the link is broken, space doubles while seeding; accepted 2026-10-27).",
  "tags": "",
  "priority": 0,
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "id": "in",
      "position": {
        "x": 500,
        "y": 0
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "Is H.264?",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "id": "codec",
      "position": {
        "x": 500,
        "y": 200
      },
      "fpEnabled": true,
      "inputsDB": {
        "codec": "h264"
      }
    },
    {
      "name": "Is 10-bit (Hi10P)?",
      "sourceRepo": "Community",
      "pluginName": "check10Bit",
      "version": "1.0.0",
      "id": "tenbit",
      "position": {
        "x": 500,
        "y": 300
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "Require NVENC worker",
      "sourceRepo": "Community",
      "pluginName": "tagsWorkerType",
      "version": "1.0.0",
      "id": "gpu",
      "position": {
        "x": 500,
        "y": 400
      },
      "fpEnabled": true,
      "inputsDB": {
        "requiredWorkerType": "GPU:nvenc"
      }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "id": "start",
      "position": {
        "x": 500,
        "y": 500
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "HEVC NVENC (CPU decode)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "id": "enc",
      "position": {
        "x": 500,
        "y": 600
      },
      "fpEnabled": true,
      "inputsDB": {
        "outputCodec": "hevc",
        "ffmpegPresetEnabled": "true",
        "ffmpegPreset": "slow",
        "ffmpegQualityEnabled": "false",
        "hardwareEncoding": "true",
        "hardwareType": "nvenc",
        "hardwareDecoding": "false",
        "forceEncoding": "false"
      }
    },
    {
      "name": "Main10 / p010le",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommand10BitVideo",
      "version": "1.0.0",
      "id": "main10",
      "position": {
        "x": 500,
        "y": 700
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "VBR CQ 21 + spatial AQ",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "rc",
      "position": {
        "x": 500,
        "y": 800
      },
      "fpEnabled": true,
      "inputsDB": {
        "inputArguments": "",
        "outputArguments": "-rc vbr -cq 21 -b:v 0 -spatial_aq 1"
      }
    },
    {
      "name": "Execute",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "id": "exec",
      "position": {
        "x": 500,
        "y": 900
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "Duration within 0.5%",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "id": "dur",
      "position": {
        "x": 500,
        "y": 1000
      },
      "fpEnabled": true,
      "inputsDB": {
        "greaterThan": "99.5",
        "lessThan": "100.5"
      }
    },
    {
      "name": "Fail (keep original)",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "fail",
      "position": {
        "x": 800,
        "y": 1100
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "Output smaller than original (20-95%)",
      "sourceRepo": "Community",
      "pluginName": "compareFileSizeRatio",
      "version": "1.0.0",
      "id": "size",
      "position": {
        "x": 500,
        "y": 1100
      },
      "fpEnabled": true,
      "inputsDB": {
        "greaterThan": "20",
        "lessThan": "95"
      }
    },
    {
      "name": "Replace Original File (new inode)",
      "sourceRepo": "Community",
      "pluginName": "replaceOriginalFile",
      "version": "1.0.0",
      "id": "replace",
      "position": {
        "x": 500,
        "y": 1200
      },
      "fpEnabled": true,
      "inputsDB": {}
    },
    {
      "name": "Sonarr: refresh series",
      "sourceRepo": "Community",
      "pluginName": "notifyRadarrOrSonarr",
      "version": "1.0.0",
      "id": "notify1",
      "position": {
        "x": 500,
        "y": 1300
      },
      "fpEnabled": true,
      "inputsDB": {
        "arr": "sonarr",
        "arr_api_key": "<SONARR_API_KEY>",
        "arr_host": "https://sonarr.<SECRET_DOMAIN>"
      }
    },
    {
      "name": "Wait for Sonarr rescan",
      "sourceRepo": "Community",
      "pluginName": "waitTimeout",
      "version": "1.0.0",
      "id": "wait",
      "position": {
        "x": 500,
        "y": 1400
      },
      "fpEnabled": true,
      "inputsDB": {
        "amount": "90",
        "unit": "seconds"
      }
    },
    {
      "name": "Sonarr naming policy",
      "sourceRepo": "Community",
      "pluginName": "applyRadarrOrSonarrNamingPolicy",
      "version": "1.0.0",
      "id": "rename",
      "position": {
        "x": 500,
        "y": 1500
      },
      "fpEnabled": true,
      "inputsDB": {
        "arr": "sonarr",
        "arr_api_key": "<SONARR_API_KEY>",
        "arr_host": "https://sonarr.<SECRET_DOMAIN>"
      }
    },
    {
      "name": "Sonarr: refresh after rename",
      "sourceRepo": "Community",
      "pluginName": "notifyRadarrOrSonarr",
      "version": "1.0.0",
      "id": "notify2",
      "position": {
        "x": 500,
        "y": 1600
      },
      "fpEnabled": true,
      "inputsDB": {
        "arr": "sonarr",
        "arr_api_key": "<SONARR_API_KEY>",
        "arr_host": "https://sonarr.<SECRET_DOMAIN>"
      }
    }
  ],
