#shellcheck disable=SC2148,SC2155
export KUBECONFIG="$(expand_path ./kubeconfig)"
export SOPS_AGE_KEY_FILE="$(expand_path ./age.key)"
# Talos
export TALOSCONFIG="$(expand_path ./kubernetes/bootstrap/talos/clusterconfig/talosconfig)"
# Bin - workstation only. Inside a devcontainer the image ships pinned tools in
# /usr/local/bin, and prepending ./.bin would shadow them with older copies left
# behind by `task workstation:generic-linux`.
if [[ -z "${REMOTE_CONTAINERS:-}" && -z "${CODESPACES:-}" ]]; then
    PATH_add "$(expand_path ./.bin)"
fi
# Taskfile
export TASK_X_ENV_PRECEDENCE=1
export TASK_X_MAP_VARIABLES=0
